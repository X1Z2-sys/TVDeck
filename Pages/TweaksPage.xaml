<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TVDeck.Pages.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel x:Name="Root" Padding="36,24,36,36" Spacing="4" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Tweaks" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Every change can be undone — each card says how. Before the first change, TVDeck saves a settings snapshot you can restore from Backup. Settings that don't apply to this TV are hidden." />
            <Border x:Name="RecommendPanel" Visibility="Collapsed" Padding="16,12" Margin="0,8,0,0" CornerRadius="{StaticResource OverlayCornerRadius}" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Recommended for every TV" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Tweaks marked Recommended are low risk, fully reversible and turn nothing you use off. You'll see the list before anything changes." />
                    </StackPanel>
                    <Button x:Name="RecommendBtn" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Click="Recommend_Click" />
                </Grid>
            </Border>
            <ProgressRing x:Name="Ring" IsActive="True" HorizontalAlignment="Left" Margin="0,16" />
            <TextBlock x:Name="NoDevice" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Connect a TV to see its settings." />
            <StackPanel x:Name="Groups" Spacing="4">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
