<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TVDeck.Pages.ConsolePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="36,24,36,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Console" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Runs adb shell commands on the connected TV. Up/Down recalls earlier commands." />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Temperatures" Tag="dumpsys thermalservice | head -30" Click="Preset_Click" />
            <Button Content="Memory" Tag="cat /proc/meminfo | head -8" Click="Preset_Click" />
            <Button Content="Storage" Tag="df -h /data /sdcard" Click="Preset_Click" />
            <Button Content="Display" Tag="wm size; wm density; dumpsys display | grep -m3 -i 'mode\|refresh'" Click="Preset_Click" />
            <Button Content="Running app" Tag="dumpsys activity activities | grep -m1 -i 'ResumedActivity'" Click="Preset_Click" />
            <Button Content="Network" Tag="ip -4 addr show wlan0 2>/dev/null; ip -4 addr show eth0 2>/dev/null; settings get global private_dns_specifier" Click="Preset_Click" />
        </StackPanel>
        <Border Grid.Row="2" CornerRadius="{StaticResource OverlayCornerRadius}" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ScrollViewer x:Name="Scroll" Padding="16,12">
                <TextBlock x:Name="Output" FontFamily="Cascadia Mono, Consolas" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input" FontFamily="Cascadia Mono, Consolas" PlaceholderText="e.g. pm list packages -3" KeyDown="Input_KeyDown" AutomationProperties.Name="Command" />
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Content="Run" Click="Run_Click" />
            <Button Grid.Column="2" Content="Clear" Click="Clear_Click" />
        </Grid>
    </Grid>
</Page>
