<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TVDeck.Pages.ScreenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Page.Resources>
        <Style x:Key="RemoteKey" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,16,24,24" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- Screen -->
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left" IsDynamicOverflowEnabled="True">
                <CommandBar.Content>
                    <ComboBox x:Name="QualityBox" Margin="0,4,12,0" MinWidth="200" AutomationProperties.Name="Mirror quality" SelectionChanged="Quality_Changed" />
                </CommandBar.Content>
                <AppBarButton x:Name="StartBtn" Label="Start" Click="Start_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE768;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="StopBtn" Label="Stop" Click="Stop_Click" Visibility="Collapsed">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE71A;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Full screen" Click="Fullscreen_Click" ToolTipService.ToolTip="Full screen (F11)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE740;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Pop out" Click="PopOut_Click" ToolTipService.ToolTip="Open in a separate scrcpy window with sound">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8A7;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Screenshot" Click="Screenshot_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE722;" /></AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarToggleButton x:Name="StatsToggle" Label="Show stream stats" Click="Stats_Click">
                        <AppBarToggleButton.Icon><FontIcon Glyph="&#xE9D9;" /></AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarToggleButton x:Name="AudioToggle" Label="Sound in pop-out window" IsChecked="True">
                        <AppBarToggleButton.Icon><FontIcon Glyph="&#xE767;" /></AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <Grid Grid.Row="1" CornerRadius="12" Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <controls:WebView2 x:Name="View" DefaultBackgroundColor="Transparent" Margin="16" />
                <StackPanel x:Name="Idle" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="380">
                    <FontIcon Glyph="&#xE7F4;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="IdleTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" Text="Your TV screen shows up here" />
                    <TextBlock x:Name="IdleBody" Style="{StaticResource BodyTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Click the screen to control it with your mouse and keyboard. Arrows move, Enter selects, Esc goes back." />
                    <ProgressRing x:Name="StartRing" IsActive="False" />
                    <Button x:Name="IdleStart" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Content="Start mirroring" Click="Start_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Remote -->
        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="16" Padding="0,8,0,0">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Remote" />

                <Grid HorizontalAlignment="Center" RowSpacing="6" ColumnSpacing="6">
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource RemoteKey}" Tag="BACK" Click="Key_Click" AutomationProperties.Name="Back" ToolTipService.ToolTip="Back (Esc)"><FontIcon Glyph="&#xE72B;" FontSize="16" /></Button>
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource RemoteKey}" Tag="DPAD_UP" Click="Key_Click" AutomationProperties.Name="Up"><FontIcon Glyph="&#xE70E;" FontSize="16" /></Button>
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource RemoteKey}" Tag="HOME" Click="Key_Click" AutomationProperties.Name="Home" ToolTipService.ToolTip="Home (F1)"><FontIcon Glyph="&#xE80F;" FontSize="16" /></Button>
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource RemoteKey}" Tag="DPAD_LEFT" Click="Key_Click" AutomationProperties.Name="Left"><FontIcon Glyph="&#xE76B;" FontSize="16" /></Button>
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Width="56" Height="44" CornerRadius="22" Tag="DPAD_CENTER" Click="Key_Click" AutomationProperties.Name="Select" Content="OK" />
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource RemoteKey}" Tag="DPAD_RIGHT" Click="Key_Click" AutomationProperties.Name="Right"><FontIcon Glyph="&#xE76C;" FontSize="16" /></Button>
                    <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource RemoteKey}" Tag="MENU" Click="Key_Click" AutomationProperties.Name="Menu" ToolTipService.ToolTip="Menu (F2)"><FontIcon Glyph="&#xE700;" FontSize="16" /></Button>
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource RemoteKey}" Tag="DPAD_DOWN" Click="Key_Click" AutomationProperties.Name="Down"><FontIcon Glyph="&#xE70D;" FontSize="16" /></Button>
                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource RemoteKey}" Tag="SETTINGS" Click="Key_Click" AutomationProperties.Name="Settings"><FontIcon Glyph="&#xE713;" FontSize="16" /></Button>
                </Grid>

                <Grid ColumnSpacing="6" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource RemoteKey}" Width="42" Tag="MEDIA_REWIND" Click="Key_Click" AutomationProperties.Name="Rewind"><FontIcon Glyph="&#xEB9E;" FontSize="14" /></Button>
                    <Button Grid.Column="1" Style="{StaticResource RemoteKey}" Width="42" Tag="MEDIA_PLAY_PAUSE" Click="Key_Click" AutomationProperties.Name="Play or pause"><FontIcon Glyph="&#xE768;" FontSize="14" /></Button>
                    <Button Grid.Column="2" Style="{StaticResource RemoteKey}" Width="42" Tag="MEDIA_FAST_FORWARD" Click="Key_Click" AutomationProperties.Name="Fast forward"><FontIcon Glyph="&#xEB9D;" FontSize="14" /></Button>
                    <Button Grid.Column="3" Style="{StaticResource RemoteKey}" Width="42" Tag="POWER" Click="Key_Click" AutomationProperties.Name="Power"><FontIcon Glyph="&#xE7E8;" FontSize="14" /></Button>
                </Grid>
                <Grid ColumnSpacing="6" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource RemoteKey}" Width="42" Tag="VOLUME_DOWN" Click="Key_Click" AutomationProperties.Name="Volume down"><FontIcon Glyph="&#xE993;" FontSize="14" /></Button>
                    <Button Grid.Column="1" Style="{StaticResource RemoteKey}" Width="42" Tag="VOLUME_MUTE" Click="Key_Click" AutomationProperties.Name="Mute"><FontIcon Glyph="&#xE74F;" FontSize="14" /></Button>
                    <Button Grid.Column="2" Style="{StaticResource RemoteKey}" Width="42" Tag="VOLUME_UP" Click="Key_Click" AutomationProperties.Name="Volume up"><FontIcon Glyph="&#xE995;" FontSize="14" /></Button>
                    <Button Grid.Column="3" Style="{StaticResource RemoteKey}" Width="42" Tag="APP_SWITCH" Click="Key_Click" AutomationProperties.Name="Recent apps"><FontIcon Glyph="&#xE8A9;" FontSize="14" /></Button>
                </Grid>

                <MenuFlyoutSeparator />

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Type on the TV" />
                <TextBox x:Name="TypeBox" PlaceholderText="Search, passwords, URLs…" KeyDown="TypeBox_KeyDown" AutomationProperties.Name="Text to send to the TV" />
                <Button Content="Send text" HorizontalAlignment="Stretch" Click="Send_Click" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="Tip: while mirroring, just click the screen and type — or paste with Ctrl+V. Right-click is Back, middle-click is Home." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
